{
  "schema_version": 1,
  "annotation_policy": "人工受控结构循环标注：成功 NUL find 来源，唯一根内路径，显式 cwd，依赖屏障有效且消费者完整连续同模板。后续输出仅在重放阶段验证。",
  "cases": [
    {
      "id": "L001",
      "rationale": "NUL 枚举后按原顺序读取两个普通文件，形成完整绑定循环。",
      "steps": [
        {
          "id": "p",
          "command": "find src -type f -print0",
          "output": "src/a\u0000src/b\u0000",
          "returncode": 0,
          "cwd": "/repo"
        },
        {
          "id": "a",
          "command": "cat src/a",
          "output": "alpha\n",
          "returncode": 0,
          "cwd": "/repo"
        },
        {
          "id": "b",
          "command": "cat src/b",
          "output": "beta\n",
          "returncode": 0,
          "cwd": "/repo"
        }
      ],
      "expected": [
        [
          "a",
          "b"
        ]
      ],
      "repository": {
        "src/a": "alpha\n",
        "src/b": "beta\n"
      }
    },
    {
      "id": "L002",
      "rationale": "三个文件的完整序列为一个循环，不能拆成两个文件的跨度。",
      "steps": [
        {
          "id": "p",
          "command": "find src -type f -print0",
          "output": "src/a\u0000src/b\u0000src/c\u0000",
          "returncode": 0,
          "cwd": "/repo"
        },
        {
          "id": "a",
          "command": "cat src/a",
          "output": "alpha\n",
          "returncode": 0,
          "cwd": "/repo"
        },
        {
          "id": "b",
          "command": "cat src/b",
          "output": "beta\n",
          "returncode": 0,
          "cwd": "/repo"
        },
        {
          "id": "c",
          "command": "cat src/c",
          "output": "gamma\n",
          "returncode": 0,
          "cwd": "/repo"
        }
      ],
      "expected": [
        [
          "a",
          "b",
          "c"
        ]
      ],
      "repository": {
        "src/a": "alpha\n",
        "src/b": "beta\n",
        "src/c": "gamma\n"
      }
    },
